+const ASSET_VERSION_CACHE = new Map();
+
+/* Version de cache derivada del propio archivo: cambia sola cuando cambia dashboard.js
+   o styles.css, de modo que el ?v= del HTML no puede quedar obsoleto (antes era un
+   literal fijo '20261011-direct-2' que sobrevivia a todos los despliegues). */
+function assetVersion(asset) {
+  const filePath = path.join(__dirname, asset);
+
+  let stat;
+  try {
+    stat = fsSync.statSync(filePath);
+  } catch {
+    return 'unknown';
+  }
+
+  const key = stat.size + ':' + stat.mtimeMs;
+  const cached = ASSET_VERSION_CACHE.get(asset);
+
+  if (cached && cached.key === key) {
+    return cached.version;
+  }
+
+  /* La version se calcula sobre el CONTENIDO del archivo, no sobre su mtime: asi una
+     reescritura con el mismo contenido no invalida la cache, y cualquier cambio real la
+     invalida siempre. */
+  let version;
+  try {
+    version = crypto
+      .createHash('sha1')
+      .update(fsSync.readFileSync(filePath))
+      .digest('hex')
+      .slice(0, 10);
+  } catch {
+    version = 'unknown';
+  }
+
+  ASSET_VERSION_CACHE.set(asset, { key: key, version: version });
+  return version;
+}
+
+/* Sirve index.html sustituyendo el ?v= de cada asset por su version real. */
+function renderIndexHtml() {
+  const html = fsSync.readFileSync(path.join(__dirname, 'index.html'), 'utf8');
+
+  return html.replace(
+    /(["'])((?:dashboard\.js|styles\.css))\?v=[^"']*\1/g,
+    function (_match, quote, asset) {
+      return quote + asset + '?v=' + assetVersion(asset) + quote;
+    }
+  );
+}
