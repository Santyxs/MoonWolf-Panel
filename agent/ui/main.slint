import { LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// ─── Tema ───────────────────────────────────────────────────────────────────

global Theme {
    out property <color> bg: #0b0d19;
    out property <color> card: #11142a;
    out property <color> line: #252a46;
    out property <color> field: #1b1f3a;
    out property <color> field-border: #343a5c;
    out property <color> accent: #8b7bff;
    out property <color> accent-soft: #c3b9ff;
    out property <color> green: #3dd9a8;
    out property <color> amber: #f0b84a;
    out property <color> text: #f4f2ff;
    out property <color> muted: #8a90b4;
    out property <color> muted-dim: #6a7094;
}

// ─── Componentes ────────────────────────────────────────────────────────────

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> label-font-size: 12px;
    callback clicked();

    height: 38px;
    border-radius: 10px;
    background: root.primary ? #6d5be5
             : root.danger  ? #3a2528
             : Theme.field;
    border-width: 1px;
    border-color: root.primary ? #b3a8ff
                 : root.danger  ? #7a3a42
                 : Theme.field-border;
    drop-shadow-blur: root.primary ? 18px : 0px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #6d5be566;

    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

    if root.primary : Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(180deg, #a899ff 0%, #6d5be5 100%);
        opacity: ta.pressed ? 0.75 : ta.has-hover ? 1.0 : 0.88;
        animate opacity { duration: 140ms; easing: ease-out; }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: #ffffff;
        font-size: root.label-font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.primary && !root.danger: {
            background: #272c4d;
            border-color: #5a6296;
        }
        hover-danger when ta.has-hover && root.danger: {
            background: #4c2f34;
            border-color: #a24b57;
        }
        pressed when ta.pressed && !root.primary: {
            background: #151830;
        }
    ]
}

component Divider inherits HorizontalBox {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0px;
    padding-bottom: 0px;
    Rectangle { height: 1px; background: Theme.line; horizontal-stretch: 1; }
}

component FieldRow inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <string> action-label;
    in property <bool> code: false;
    callback action-clicked();

    height: 54px;
    background: transparent;
    clip: true;

    VerticalBox {
        x: 12px;
        y: 8px;
        width: parent.width - 92px;
        spacing: 3px;
        alignment: start;

        Text {
            text: root.caption;
            color: Theme.muted-dim;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: 1.2px;
            horizontal-alignment: left;
        }
        Text {
            text: root.value;
            color: root.code ? Theme.accent-soft : Theme.text;
            font-family: root.code ? "Consolas" : "";
            font-size: root.code ? 15px : 12px;
            font-weight: root.code ? 700 : 600;
            letter-spacing: root.code ? 1.6px : 0px;
            overflow: elide;
            horizontal-alignment: left;
        }
    }

    if root.action-label != "" : ActionButton {
        x: parent.width - 82px;
        y: 13px;
        width: 70px;
        height: 28px;
        label: root.action-label;
        label-font-size: 11px;
        clicked => { root.action-clicked(); }
    }
}

component StatusDot inherits Rectangle {
    in property <bool> ok;
    property <color> tone: root.ok ? Theme.green : Theme.amber;
    property <float> p: mod(animation-tick() / 2s, 1.0);

    width: 22px;
    height: 22px;

    Rectangle {
        width: 10px + 12px * root.p;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: root.tone.with-alpha(1.0 - root.p);
        background: transparent;
    }
    Rectangle {
        width: 10px;
        height: 10px;
        x: 6px;
        y: 6px;
        border-radius: 5px;
        background: root.tone;
        drop-shadow-blur: 10px;
        drop-shadow-color: root.tone.with-alpha(0.7);
    }
}

component Modal inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> closable: true;
    callback close();
    property <bool> ready: false;

    border-radius: 18px;
    background: #14172e;
    border-width: 1px;
    border-color: #6a5ad8;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #000000d0;
    clip: true;
    opacity: root.ready ? 1.0 : 0.0;
    animate opacity { duration: 180ms; easing: ease-out; }
    init => { root.ready = true; }

    Rectangle {
        height: 70px;
        y: 0px;
        background: @linear-gradient(180deg, #8b7bff22 0%, #8b7bff00 100%);
    }

    VerticalBox {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 10px;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 800;
            horizontal-alignment: left;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 11px;
            horizontal-alignment: left;
        }
        Rectangle { height: 1px; background: Theme.line; }

        @children
    }

    if root.closable : Rectangle {
        x: parent.width - 40px;
        y: 12px;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: close-ta.has-hover ? #3a2a40 : Theme.field;
        border-width: 1px;
        border-color: close-ta.has-hover ? #8a4a62 : Theme.field-border;
        animate background { duration: 120ms; }
        Text {
            height: 100%;
            text: "×";
            color: close-ta.has-hover ? #ffb4c4 : #c0c4d8;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close(); }
        }
    }
}

// ─── Ventana principal ──────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "MoonWolf Agent";
    min-width: 320px;
    preferred-width: 340px;
    max-width: 380px;
    min-height: 460px;
    preferred-height: 500px;
    max-height: 560px;
    background: Theme.bg;

    callback open-panel();
    callback open-config();
    callback open-server();
    callback change-server(string);
    callback copy-pairing();
    callback clear-logs();
    callback save-logs();
    callback check-update();
    callback apply-update();
    callback restart-agent();
    callback hide-tray();
    callback quit-agent();

    in-out property <string> status-title: "Conectando...";
    in-out property <string> status-description: "Conectando con MoonWolf Cloud";
    in-out property <string> pairing-code: "—";
    in-out property <string> server-dir: "—";
    in-out property <string> version: "—";
    in-out property <string> local-status: "Servidor local";
    in-out property <string> agent-id: "—";
    in-out property <string> config-dir: "—";
    in-out property <string> update-text: "";
    in-out property <string> logs-text: "";
    in-out property <bool> cloud-connected: false;
    in-out property <bool> local-ready: false;
    in-out property <bool> update-visible: false;
    in-out property <bool> update-installable: false;
    in-out property <bool> update-failed: false;
    in-out property <bool> restart-visible: false;
    in-out property <bool> logs-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> serverdir-visible: false;
    in-out property <string> serverdir-input: "";
    in-out property <string> copy-label: "Copiar";

    Rectangle {
        height: 100%;
        background: @linear-gradient(170deg, #141731 0%, #0b0d19 45%, #090b15 100%);

        // Resplandor ambiental superior
        Rectangle {
            x: (parent.width - 380px) / 2;
            y: -150px;
            width: 380px;
            height: 300px;
            background: @radial-gradient(circle, #7a68f044 0%, #7a68f000 70%);
        }

        VerticalBox {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 10px;
            alignment: start;

            // ── Cabecera ──
            HorizontalBox {
                height: 48px;
                spacing: 12px;
                alignment: center;

                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 13px;
                    background: #1c1846;
                    border-width: 1.5px;
                    border-color: #8b7bff;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #7a68f088;

                    Rectangle {
                        x: 9px; y: 9px;
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: #ffffff;
                    }
                    Rectangle {
                        x: 16px; y: 6px;
                        width: 22px; height: 22px;
                        border-radius: 11px;
                        background: #1c1846;
                    }
                    Rectangle {
                        x: 27px; y: 27px;
                        width: 3px; height: 3px;
                        border-radius: 2px;
                        background: #c3b9ff;
                    }
                }

                VerticalBox {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "MoonWolf";
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 800;
                    }
                    Text {
                        text: "AGENT";
                        color: Theme.accent;
                        font-size: 8px;
                        font-weight: 800;
                        letter-spacing: 3px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // ── Estado ──
            Rectangle {
                height: 58px;
                border-radius: 13px;
                background: root.cloud-connected
                    ? @linear-gradient(90deg, #12302c 0%, #11142a 70%)
                    : @linear-gradient(90deg, #2c2615 0%, #11142a 70%);
                border-width: 1px;
                border-color: root.cloud-connected ? #2b5a50 : #4a4326;
                clip: true;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;

                    StatusDot { ok: root.cloud-connected; }
                    VerticalBox {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.cloud-connected ? "Conectado" : root.status-title;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: root.cloud-connected ? "Conexión activa con MoonWolf Cloud" : root.status-description;
                            color: root.cloud-connected ? #8fd9c3 : #d6bf84;
                            font-size: 10px;
                            overflow: elide;
                            horizontal-alignment: left;
                        }
                    }
                }
            }

            Text {
                text: "INFORMACIÓN DEL AGENT";
                color: Theme.muted-dim;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.5px;
                horizontal-alignment: left;
            }

            // ── Tarjeta de información ──
            Rectangle {
                border-radius: 14px;
                background: @linear-gradient(180deg, #151933 0%, #0f1226 100%);
                border-width: 1px;
                border-color: Theme.line;
                clip: true;

                VerticalBox {
                    padding: 2px;
                    spacing: 0px;
                    alignment: start;
                    FieldRow {
                        caption: "CÓDIGO DE EMPAREJAMIENTO";
                        value: root.pairing-code;
                        code: true;
                        action-label: root.copy-label;
                        action-clicked => { root.copy-pairing(); }
                    }
                    Divider { }
                    FieldRow {
                        caption: "CARPETA DEL SERVIDOR";
                        value: root.server-dir;
                        action-label: "Cambiar";
                        action-clicked => {
                            root.settings-visible = false;
                            root.logs-visible = false;
                            root.serverdir-visible = !root.serverdir-visible;
                        }
                    }
                    Divider { }
                    Rectangle {
                        height: 54px;
                        background: transparent;
                        clip: true;
                        HorizontalBox {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: center;
                            VerticalBox {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: "VERSIÓN";
                                    color: Theme.muted-dim;
                                    font-size: 8px;
                                    font-weight: 800;
                                    letter-spacing: 1.2px;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: "v" + root.version;
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: left;
                                }
                            }
                            Rectangle { width: 1px; height: 28px; background: Theme.line; }
                            VerticalBox {
                                width: 12px;
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.local-ready ? Theme.green : Theme.amber;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: (root.local-ready ? Theme.green : Theme.amber).with-alpha(0.7);
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: "SERVIDOR LOCAL";
                                    color: Theme.muted-dim;
                                    font-size: 8px;
                                    font-weight: 800;
                                    letter-spacing: 1.0px;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: root.local-ready ? "En funcionamiento" : "Iniciando...";
                                    color: root.local-ready ? #5eebc4 : #f0c878;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
            }

            // ── Acciones ──
            ActionButton {
                height: 44px;
                label: "Abrir MoonWolf Panel  →";
                label-font-size: 13px;
                primary: true;
                clicked => { root.open-panel(); }
            }

            HorizontalBox {
                height: 40px;
                spacing: 8px;
                padding: 0px;
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Configuración";
                    clicked => {
                        root.logs-visible = false;
                        root.serverdir-visible = false;
                        root.settings-visible = !root.settings-visible;
                    }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Logs";
                    clicked => {
                        root.settings-visible = false;
                        root.serverdir-visible = false;
                        root.logs-visible = !root.logs-visible;
                    }
                }
            }

            if root.update-visible : Rectangle {
                height: 56px;
                border-radius: 14px;
                background: @linear-gradient(90deg, #272054 0%, #15122e 100%);
                border-width: 1px;
                border-color: #5a4ca8;
                HorizontalBox {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: root.update-text;
                        color: #e4e0ff;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    if root.update-installable : ActionButton {
                        width: 80px;
                        height: 34px;
                        label: "Instalar";
                        primary: true;
                        clicked => { root.apply-update(); }
                    }
                    if root.update-failed : ActionButton {
                        width: 80px;
                        height: 34px;
                        label: "Reintentar";
                        clicked => { root.check-update(); }
                    }
                    if !root.update-installable && !root.update-failed : Text {
                        text: "Descargando";
                        color: #b6aaff;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            if root.restart-visible : Rectangle {
                height: 52px;
                border-radius: 14px;
                background: @linear-gradient(90deg, #35291a 0%, #1d1710 100%);
                border-width: 1px;
                border-color: #7a5630;
                HorizontalBox {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: "Hay un reinicio pendiente";
                        color: #f0d49a;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    ActionButton {
                        width: 96px;
                        height: 34px;
                        label: "Reiniciar";
                        clicked => { root.restart-agent(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ── Fondo oscuro de los modales ──
        if root.settings-visible || root.logs-visible || root.serverdir-visible : Rectangle {
            height: 100%;
            background: #05060ccc;
            TouchArea {
                clicked => {
                    root.settings-visible = false;
                    root.logs-visible = false;
                    root.serverdir-visible = false;
                }
            }
        }

        // ── Configuración ──
        if root.settings-visible : Modal {
            x: 14px;
            y: (root.height - self.height) / 2;
            width: root.width - 28px;
            height: root.update-visible ? 336px : 262px;
            title: "Configuración";
            subtitle: "Gestiona las opciones de MoonWolf Agent.";
            close => { root.settings-visible = false; }

            ActionButton {
                label: "Abrir carpeta de configuración";
                clicked => { root.open-config(); }
            }
            ActionButton {
                label: "Buscar actualizaciones";
                clicked => { root.check-update(); }
            }
            if root.update-visible : Rectangle {
                height: 56px;
                border-radius: 12px;
                background: @linear-gradient(90deg, #272054 0%, #15122e 100%);
                border-width: 1px;
                border-color: #5a4ca8;
                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: root.update-text;
                        color: #e4e0ff;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    if root.update-installable : ActionButton {
                        width: 76px;
                        height: 32px;
                        label: "Instalar";
                        primary: true;
                        clicked => { root.apply-update(); }
                    }
                    if root.update-failed : ActionButton {
                        width: 76px;
                        height: 32px;
                        label: "Reintentar";
                        clicked => { root.check-update(); }
                    }
                    if !root.update-installable && !root.update-failed : Text {
                        text: "Descargando";
                        color: #b6aaff;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            ActionButton {
                label: "Ocultar en segundo plano";
                clicked => { root.hide-tray(); }
            }
        }

        // ── Registros ──
        if root.logs-visible : Modal {
            x: 14px;
            y: (root.height - self.height) / 2;
            width: root.width - 28px;
            height: 356px;
            title: "Registros del Agent";
            close => { root.logs-visible = false; }

            HorizontalBox {
                spacing: 10px;
                padding: 0px;
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Limpiar";
                    clicked => { root.clear-logs(); }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Guardar archivo";
                    clicked => { root.save-logs(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 180px;
                border-radius: 12px;
                background: #080a15;
                border-width: 1px;
                border-color: Theme.line;
                clip: true;

                Text {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text: root.logs-text == "" ? "Todavía no hay registros.\nLos eventos del Agent aparecerán aquí." : root.logs-text;
                    color: root.logs-text == "" ? #5a5f7a : #c8cce0;
                    font-family: "Consolas";
                    font-size: 10px;
                    wrap: word-wrap;
                    overflow: elide;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
            }
        }

        // ── Carpeta del servidor ──
        if root.serverdir-visible : Modal {
            x: 14px;
            y: (root.height - self.height) / 2;
            width: root.width - 28px;
            height: 270px;
            title: "Carpeta del servidor";
            subtitle: "Indica la ruta de la carpeta local del servidor.";
            close => { root.serverdir-visible = false; }

            LineEdit {
                text <=> root.serverdir-input;
                placeholder-text: "Ruta completa de la carpeta...";
                height: 40px;
                horizontal-stretch: 1;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalBox {
                spacing: 10px;
                height: 40px;
                padding: 0px;
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "Cancelar";
                    clicked => { root.serverdir-visible = false; }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "Guardar";
                    primary: true;
                    clicked => {
                        root.change-server(root.serverdir-input);
                        root.serverdir-visible = false;
                    }
                }
            }
        }
    }
}
