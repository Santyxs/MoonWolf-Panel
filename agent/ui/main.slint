import { Button, LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

component PillButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    callback clicked();

    height: 48px;
    border-radius: 12px;
    background: #15182b;
    border-width: 1px;
    border-color: #282b47;

    HorizontalBox {
        spacing: 8px;
        alignment: center;
        Text {
            text: root.glyph;
            color: #d2c7ff;
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: #f5f1ff;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component FieldRow inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <string> action-label;
    callback action-clicked();

    height: 69px;
    background: #111426;
    border-width: 1px;
    border-color: #242844;

    HorizontalBox {
        padding-left: 15px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        VerticalBox {
            spacing: 5px;
            horizontal-stretch: 1;
            Text {
                text: root.caption;
                color: #85879d;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.2px;
            }
            Text {
                text: root.value;
                color: #f0eff8;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.action-label != "" : Button {
            text: root.action-label;
            clicked => { root.action-clicked(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "MoonWolf Agent";
    min-width: 410px;
    preferred-width: 470px;
    max-width: 520px;
    min-height: 650px;
    preferred-height: 745px;
    max-height: 820px;
    background: #0b0c17;

    callback open-panel();
    callback open-config();
    callback open-server();
    callback change-server(string);
    callback copy-pairing();
    callback clear-logs();
    callback save-logs();
    callback check-update();
    callback apply-update();
    callback restart-agent();
    callback hide-tray();
    callback quit-agent();

    in-out property <string> status-title: "Conectando...";
    in-out property <string> status-description: "Conectando con MoonWolf Cloud";
    in-out property <string> pairing-code: "—";
    in-out property <string> server-dir: "—";
    in-out property <string> version: "—";
    in-out property <string> local-status: "Servidor local";
    in-out property <string> agent-id: "—";
    in-out property <string> config-dir: "—";
    in-out property <string> update-text: "";
    in-out property <string> logs-text: "";
    in-out property <bool> cloud-connected: false;
    in-out property <bool> local-ready: false;
    in-out property <bool> update-visible: false;
    in-out property <bool> restart-visible: false;
    in-out property <bool> logs-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> serverdir-visible: false;
    in-out property <string> serverdir-input: "";

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0b0c17;

        VerticalBox {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 27px;
            padding-bottom: 18px;
            spacing: 13px;

            // Marca compacta, como en la referencia
            VerticalBox {
                height: 118px;
                spacing: 8px;
                alignment: center;

                HorizontalBox {
                    height: 64px;
                    spacing: 14px;
                    alignment: center;

                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 18px;
                        background: #6654d9;
                        border-width: 1px;
                        border-color: #897bff;

                        Rectangle {
                            x: 18px;
                            y: 15px;
                            width: 31px;
                            height: 31px;
                            border-radius: 16px;
                            background: #fffaff;
                        }
                        Rectangle {
                            x: 29px;
                            y: 10px;
                            width: 31px;
                            height: 31px;
                            border-radius: 16px;
                            background: #6654d9;
                        }
                    }

                    VerticalBox {
                        spacing: 1px;
                        alignment: center;
                        Text {
                            text: "MoonWolf";
                            color: #fbfaff;
                            font-size: 26px;
                            font-weight: 800;
                        }
                        Text {
                            text: "Agent";
                            color: #c9c3df;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // Estado de conexión
            Rectangle {
                height: 77px;
                border-radius: 15px;
                background: #111426;
                border-width: 1px;
                border-color: #292b48;

                HorizontalBox {
                    padding-left: 17px;
                    padding-right: 17px;
                    spacing: 13px;
                    alignment: center;

                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: root.cloud-connected ? #54f0c0 : #f4c86d;
                    }

                    VerticalBox {
                        spacing: 5px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.cloud-connected ? "Conectado" : root.status-title;
                            color: #faf8ff;
                            font-size: 16px;
                            font-weight: 800;
                        }
                        Text {
                            text: root.cloud-connected ? "MoonWolf Agent conectado con MoonWolf Cloud" : root.status-description;
                            color: #aaa9bf;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                }
            }

            // Información principal
            Rectangle {
                border-radius: 15px;
                background: #111426;
                border-width: 1px;
                border-color: #292b48;

                VerticalBox {
                    padding: 14px;
                    spacing: 0px;

                    FieldRow {
                        caption: "CÓDIGO DE EMPAREJAMIENTO";
                        value: root.pairing-code;
                        action-label: "Copiar";
                        action-clicked => { root.copy-pairing(); }
                    }
                    Rectangle { height: 1px; background: #252840; }
                    FieldRow {
                        caption: "SERVIDOR";
                        value: root.server-dir;
                        action-label: "Cambiar";
                        action-clicked => {
                            root.settings-visible = false;
                            root.logs-visible = false;
                            root.serverdir-visible = !root.serverdir-visible;
                        }
                    }
                    Rectangle { height: 1px; background: #252840; }
                    Rectangle {
                        height: 69px;
                        background: #111426;
                        HorizontalBox {
                            padding-left: 15px;
                            padding-right: 15px;
                            spacing: 10px;
                            alignment: center;
                            VerticalBox {
                                spacing: 5px;
                                horizontal-stretch: 1;
                                Text { text: "VERSIÓN"; color: #85879d; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; }
                                Text { text: "v" + root.version; color: #f0eff8; font-size: 12px; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                alignment: center;
                                Rectangle {
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 5px;
                                    background: root.local-ready ? #ff9bc7 : #f4c86d;
                                }
                                Text {
                                    text: root.local-ready ? "Servidor local listo" : "Servidor local iniciando";
                                    color: root.local-ready ? #f3c9df : #f2d78f;
                                    font-size: 10px;
                                    font-weight: 700;
                                }
                            }
                        }
                    }
                }
            }

            // CTA principal
            Button {
                text: "↗  Abrir Panel";
                primary: true;
                height: 55px;
                clicked => { root.open-panel(); }
            }

            // Acciones inferiores
            HorizontalBox {
                height: 50px;
                spacing: 10px;
                PillButton {
                    label: "Configuración";
                    glyph: "⚙";
                    horizontal-stretch: 1;
                    clicked => {
                        root.logs-visible = false;
                        root.serverdir-visible = false;
                        root.settings-visible = !root.settings-visible;
                    }
                }
                PillButton {
                    label: "Logs";
                    glyph: "▦";
                    horizontal-stretch: 1;
                    clicked => {
                        root.settings-visible = false;
                        root.serverdir-visible = false;
                        root.logs-visible = !root.logs-visible;
                    }
                }
            }

            if root.update-visible : Rectangle {
                height: 57px;
                border-radius: 12px;
                background: #1b2140;
                border-width: 1px;
                border-color: #514b9a;
                HorizontalBox {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: root.update-text; color: #e8e4ff; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "Instalar"; clicked => { root.apply-update(); } }
                }
            }

            if root.restart-visible : Rectangle {
                height: 52px;
                border-radius: 12px;
                background: #332b27;
                border-width: 1px;
                border-color: #74532b;
                HorizontalBox {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: "Reinicio pendiente"; color: #f4d79b; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: "Reiniciar"; clicked => { root.restart-agent(); } }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 3px; }
            Text {
                text: "MoonWolf Agent  ·  Windows  ·  v" + root.version;
                color: #565770;
                font-size: 9px;
                horizontal-alignment: center;
            }
        }

        // Menú de configuración compacto, superpuesto como menú emergente
        if root.settings-visible : Rectangle {
            x: 24px;
            y: 430px;
            width: root.width - 48px;
            height: 242px;
            border-radius: 15px;
            background: #181a30;
            border-width: 1px;
            border-color: #6559bd;
            drop-shadow-blur: 22px;
            drop-shadow-color: #05050dcc;

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Configuración"; color: #faf8ff; font-size: 16px; font-weight: 800; horizontal-stretch: 1; }
                    Button { text: "×"; clicked => { root.settings-visible = false; } }
                }
                Text { text: "Ajustes del Agent"; color: #aaa9bf; font-size: 10px; }
                Rectangle { height: 1px; background: #34345a; }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "Abrir carpeta"; horizontal-stretch: 1; clicked => { root.open-config(); } }
                    Button { text: "Buscar actualización"; horizontal-stretch: 1; clicked => { root.check-update(); } }
                }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "Cambiar servidor"; horizontal-stretch: 1; clicked => { root.serverdir-visible = true; } }
                    Button { text: "Minimizar"; horizontal-stretch: 1; clicked => { root.hide-tray(); } }
                }
            }
        }

        // Menú de logs compacto
        if root.logs-visible : Rectangle {
            x: 24px;
            y: 390px;
            width: root.width - 48px;
            height: 320px;
            border-radius: 15px;
            background: #181a30;
            border-width: 1px;
            border-color: #6559bd;
            drop-shadow-blur: 22px;
            drop-shadow-color: #05050dcc;

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Logs"; color: #faf8ff; font-size: 16px; font-weight: 800; horizontal-stretch: 1; }
                    Button { text: "×"; clicked => { root.logs-visible = false; } }
                }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "Limpiar"; horizontal-stretch: 1; clicked => { root.clear-logs(); } }
                    Button { text: "Guardar archivo"; horizontal-stretch: 1; clicked => { root.save-logs(); } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: #0b0c17;
                    border-width: 1px;
                    border-color: #292b48;
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalBox {
                            padding: 10px;
                            Text {
                                text: root.logs-text == "" ? "Sin registros todavía.\nLos eventos del Agent aparecerán aquí." : root.logs-text;
                                color: root.logs-text == "" ? #696b84 : #d2d0e3;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // Diálogo para la carpeta del servidor
        if root.serverdir-visible : Rectangle {
            x: (root.width - 390px) / 2;
            y: (root.height - 220px) / 2;
            width: 390px;
            height: 220px;
            border-radius: 15px;
            background: #181a30;
            border-width: 1px;
            border-color: #6559bd;
            drop-shadow-blur: 22px;
            drop-shadow-color: #05050dcc;

            VerticalBox {
                padding: 16px;
                spacing: 11px;
                Text { text: "Cambiar servidor"; color: #faf8ff; font-size: 16px; font-weight: 800; }
                Text { text: "Indica la ruta de la carpeta local."; color: #aaa9bf; font-size: 10px; }
                LineEdit { text <=> root.serverdir-input; placeholder-text: "Ruta completa de la carpeta..."; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "Cancelar"; horizontal-stretch: 1; clicked => { root.serverdir-visible = false; } }
                    Button { text: "Guardar"; primary: true; horizontal-stretch: 1; clicked => { root.change-server(root.serverdir-input); root.serverdir-visible = false; } }
                }
            }
        }
    }
}
