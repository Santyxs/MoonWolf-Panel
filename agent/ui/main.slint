import { Button, LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "MoonWolf Agent";
    width: 440px;
    height: 650px;
    min-width: 390px;
    min-height: 560px;
    background: #0c1019;

    callback open-panel();
    callback open-config();
    callback open-server();
    callback change-server(string);
    callback copy-pairing();
    callback clear-logs();
    callback save-logs();
    callback check-update();
    callback apply-update();
    callback restart-agent();
    callback hide-tray();
    callback quit-agent();

    in-out property <string> status-title: "Conectando...";
    in-out property <string> status-description: "Conectando con MoonWolf Cloud";
    in-out property <string> pairing-code: "—";
    in-out property <string> server-dir: "—";
    in-out property <string> version: "—";
    in-out property <string> local-status: "Servidor local";
    in-out property <string> agent-id: "—";
    in-out property <string> config-dir: "—";
    in-out property <string> update-text: "";
    in-out property <string> logs-text: "";
    in-out property <bool> cloud-connected: false;
    in-out property <bool> local-ready: false;
    in-out property <bool> update-visible: false;
    in-out property <bool> restart-visible: false;
    in-out property <bool> logs-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> serverdir-visible: false;
    in-out property <string> serverdir-input: "";

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #0c1019;
    }

    VerticalBox {
        padding: 22px;
        spacing: 14px;

        HorizontalBox {
            alignment: center;
            spacing: 12px;
            Rectangle {
                width: 48px; height: 48px; border-radius: 14px;
                background: #18283a;
                Text { text: "MW"; color: #68d9ff; font-size: 19px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalBox {
                alignment: center;
                Text { text: "MoonWolf"; color: #f2f5fb; font-size: 23px; font-weight: 700; }
                Text { text: "AGENT"; color: #8c9bb0; font-size: 10px; letter-spacing: 3px; }
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.version; color: #8291a8; font-size: 11px; }
        }

        Rectangle {
            height: 72px; border-radius: 12px;
            background: #151e2c;
            border-width: 1px; border-color: root.cloud-connected ? #236b68 : #344256;
            VerticalBox {
                padding: 12px; spacing: 4px;
                HorizontalBox {
                    spacing: 8px;
                    Rectangle { width: 9px; height: 9px; border-radius: 5px; background: root.cloud-connected ? #42d6a4 : #e4ae55; }
                    Text { text: root.status-title; color: #f2f5fb; font-size: 14px; font-weight: 700; }
                }
                Text { text: root.status-description; color: #a5b2c4; font-size: 11px; }
            }
        }

        Rectangle {
            border-radius: 12px; background: #151e2c;
            VerticalBox {
                padding: 14px;
                spacing: 9px;
                Text { text: "EMPAREJAMIENTO"; color: #8294ad; font-size: 10px; letter-spacing: 1px; }
                HorizontalBox {
                    Text { text: root.pairing-code; color: #73d7ff; font-size: 21px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Copiar"; clicked => { root.copy-pairing(); } }
                }
                Rectangle { height: 1px; background: #29374a; }
                Text { text: "CARPETA DEL SERVIDOR"; color: #8294ad; font-size: 10px; letter-spacing: 1px; }
                HorizontalBox {
                    Text { text: root.server-dir; color: #e3eaf4; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                    Button { text: "Abrir"; clicked => { root.open-server(); } }
                }
                HorizontalBox {
                    Text { text: "SERVIDOR LOCAL"; color: #8294ad; font-size: 10px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.local-ready ? "Listo" : "Iniciando"; color: root.local-ready ? #42d6a4 : #e4ae55; font-size: 11px; }
                }
            }
        }

        if root.update-visible : Rectangle {
            border-radius: 10px; background: #26344a;
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                Text { text: root.update-text; color: #eaf2ff; font-size: 12px; }
                Button { text: "Instalar actualización"; clicked => { root.apply-update(); } }
            }
        }

        if root.restart-visible : Rectangle {
            border-radius: 10px; background: #3a3020;
            HorizontalBox {
                padding: 10px;
                Text { text: "Reinicio pendiente"; color: #f2d39a; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Reiniciar"; clicked => { root.restart-agent(); } }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button { text: "Abrir Panel"; clicked => { root.open-panel(); } }
            Button { text: "Configuración"; clicked => { root.settings-visible = !root.settings-visible; } }
            Button { text: "Logs"; clicked => { root.logs-visible = !root.logs-visible; } }
        }

        if root.settings-visible : Rectangle {
            border-radius: 10px; background: #151e2c;
            VerticalBox {
                padding: 12px;
                spacing: 7px;
                Text { text: "CONFIGURACIÓN"; color: #8294ad; font-size: 10px; }
                Text { text: "Carpeta: " + root.config-dir; color: #b8c5d6; font-size: 10px; overflow: elide; }
                Text { text: "Agent ID: " + root.agent-id; color: #b8c5d6; font-size: 10px; overflow: elide; }
                HorizontalBox {
                    Button { text: "Abrir carpeta"; clicked => { root.open-config(); } }
                    Button { text: "Cambiar servidor"; clicked => { root.serverdir-visible = !root.serverdir-visible; } }
                    Button { text: "Buscar update"; clicked => { root.check-update(); } }
                }
                Button { text: "Minimizar a bandeja"; clicked => { root.hide-tray(); } }
            }
        }

        if root.serverdir-visible : Rectangle {
            border-radius: 10px; background: #151e2c;
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                Text { text: "Nueva carpeta del servidor"; color: #eaf2ff; }
                LineEdit { text <=> root.serverdir-input; }
                HorizontalBox {
                    Button { text: "Cancelar"; clicked => { root.serverdir-visible = false; } }
                    Button { text: "Guardar"; clicked => { root.change-server(root.serverdir-input); root.serverdir-visible = false; } }
                }
            }
        }

        if root.logs-visible : Rectangle {
            border-radius: 10px; background: #111925; vertical-stretch: 1;
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                HorizontalBox {
                    Text { text: "REGISTRO"; color: #8294ad; font-size: 10px; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Limpiar"; clicked => { root.clear-logs(); } }
                    Button { text: "Guardar"; clicked => { root.save-logs(); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    Text { text: root.logs-text; color: #b9c7d9; font-size: 10px; wrap: word-wrap; }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Text { text: "MoonWolf Agent · Windows"; color: #53647c; font-size: 9px; horizontal-alignment: center; }
    }
}
