import { LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// ─── Tema ───────────────────────────────────────────────────────────────────

global Theme {
    // Surfaces (alineado con styles.css del panel)
    out property <color> bg: #05080d;
    out property <color> card: #0b1016;
    out property <color> surface2: #0f151d;
    out property <color> surface3: #141c27;
    out property <color> line: #1b2a3a;
    out property <color> field: #0f151d;
    out property <color> field-border: #2a3c50;

    // Accent
    out property <color> accent: #00c8ff;
    out property <color> accent-soft: #7ee3ff;
    out property <color> accent-deep: #0077aa;
    out property <color> accent-glow: #00c8ff55;
    out property <color> accent-border: #00c8ff88;
    out property <color> accent-dim: #00c8ff26;

    // Semantic
    out property <color> green: #00ff88;
    out property <color> amber: #ffcc00;
    out property <color> red: #ff4455;
    out property <color> danger: #ff5c70;
    out property <color> danger-bg: #2c1a1f;
    out property <color> danger-border: #7a3a42;
    out property <color> danger-hover: #3d2229;
    out property <color> danger-border-hover: #a24b57;
    out property <color> danger-text: #ffb4bc;

    // Primary button
    out property <color> primary: #0a8fbf;
    out property <color> primary-top: #3fdcff;
    out property <color> primary-border: #6fe0ff;
    out property <color> primary-text: #02141c;

    // Text
    out property <color> text: #d3e0ee;
    out property <color> text-soft: #a8bccf;
    out property <color> muted: #7a91a8;
    out property <color> muted-dim: #5a7188;

    // Interactive
    out property <color> hover: #14202c;
    out property <color> pressed: #0a1118;
    out property <color> overlay: #020407cc;
    out property <color> modal-bg: #0a1017;
    out property <color> modal-border: #1e5a78;
    out property <color> shadow: #000000d0;
    out property <color> shadow-soft: #00000066;
    out property <color> overlay-scrim: #020407cc;
    out property <color> code-bg: #04070b;
    out property <color> log-empty: #4a5d70;
    out property <color> log-text: #b4d4e6;

    // Status OK
    out property <color> ok-bg-start: #0a2a24;
    out property <color> ok-border: #1d5a48;
    out property <color> ok-glow: #00ff8822;
    out property <color> ok-text: #8fe8c8;
    out property <color> ok-soft: #5eebc4;

    // Status warn
    out property <color> warn-bg-start: #2c2615;
    out property <color> warn-border: #4a4326;
    out property <color> warn-glow: #ffcc0018;
    out property <color> warn-text: #d6bf84;
    out property <color> warn-soft: #f0c878;
    out property <color> warn-banner-start: #35291a;
    out property <color> warn-banner-end: #14100a;
    out property <color> warn-banner-border: #7a5630;
    out property <color> warn-banner-text: #f0d49a;

    // Info banner
    out property <color> info-bg-start: #0c2e3e;
    out property <color> info-border: #1b6a8a;
    out property <color> info-text: #d2f4ff;

    // Misc surfaces
    out property <color> panel-grad-top: #0e161f;
    out property <color> ring-glow: #00c8ff33;
    out property <color> header-grad-1: #0a1620;
    out property <color> header-grad-2: #04060a;
    out property <color> pure-white: #ffffff;
}

// ─── Componentes ────────────────────────────────────────────────────────────

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> label-font-size: 12px;
    callback clicked();

    height: 38px;
    border-radius: 10px;
    background: root.primary ? Theme.primary
             : root.danger  ? Theme.danger-bg
             : Theme.field;
    border-width: 1px;
    border-color: root.primary ? Theme.primary-border
                 : root.danger  ? Theme.danger-border
                 : Theme.field-border;
    drop-shadow-blur: root.primary ? 18px : 0px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.accent-glow;

    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

    if root.primary : Rectangle {
        border-radius: root.border-radius;
        background: @linear-gradient(180deg, Theme.primary-top 0%, Theme.primary 100%);
        opacity: ta.pressed ? 0.75 : ta.has-hover ? 1.0 : 0.9;
        animate opacity { duration: 140ms; easing: ease-out; }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.primary ? Theme.primary-text : root.danger ? Theme.danger-text : Theme.text;
        font-size: root.label-font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.primary && !root.danger: {
            background: Theme.hover;
            border-color: Theme.accent-border;
        }
        hover-danger when ta.has-hover && root.danger: {
            background: Theme.danger-hover;
            border-color: Theme.danger-border-hover;
        }
        pressed when ta.pressed && !root.primary: {
            background: Theme.pressed;
        }
    ]
}

component Divider inherits HorizontalBox {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0px;
    padding-bottom: 0px;
    Rectangle { height: 1px; background: Theme.line; horizontal-stretch: 1; }
}

component FieldRow inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <string> action-label;
    in property <bool> code: false;
    callback action-clicked();

    height: 54px;
    background: transparent;
    clip: true;

    VerticalBox {
        x: 12px;
        y: 8px;
        width: parent.width - 92px;
        spacing: 3px;
        alignment: start;

        Text {
            text: root.caption;
            color: Theme.muted-dim;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.4px;
            horizontal-alignment: left;
        }
        Text {
            text: root.value;
            color: root.code ? Theme.accent-soft : Theme.text;
            font-family: root.code ? "Consolas" : "";
            font-size: root.code ? 15px : 12px;
            font-weight: root.code ? 700 : 600;
            letter-spacing: root.code ? 1.6px : 0px;
            overflow: elide;
            horizontal-alignment: left;
        }
    }

    if root.action-label != "" : ActionButton {
        x: parent.width - 82px;
        y: 13px;
        width: 70px;
        height: 28px;
        label: root.action-label;
        label-font-size: 11px;
        clicked => { root.action-clicked(); }
    }
}

component StatusDot inherits Rectangle {
    in property <bool> ok;
    property <color> tone: root.ok ? Theme.green : Theme.amber;
    property <float> p: mod(animation-tick() / 2s, 1.0);

    width: 22px;
    height: 22px;

    Rectangle {
        width: 10px + 12px * root.p;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: root.tone.with-alpha(1.0 - root.p);
        background: transparent;
    }
    Rectangle {
        width: 10px;
        height: 10px;
        x: 6px;
        y: 6px;
        border-radius: 5px;
        background: root.tone;
        drop-shadow-blur: 10px;
        drop-shadow-color: root.tone.with-alpha(0.7);
    }
}

component LogChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> tone: Theme.accent;
    callback clicked();

    height: 26px;
    horizontal-stretch: 1;
    border-radius: 13px;
    background: root.active ? root.tone.with-alpha(0.18) : Theme.field;
    border-width: 1px;
    border-color: root.active ? root.tone : (ta.has-hover ? Theme.accent-border : Theme.field-border);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Text {
        text: root.label;
        color: root.active ? root.tone : Theme.muted;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Modal inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> closable: true;
    callback close();
    property <bool> ready: false;

    border-radius: 18px;
    background: Theme.modal-bg;
    border-width: 1px;
    border-color: Theme.modal-border;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Theme.shadow;
    clip: true;
    opacity: root.ready ? 1.0 : 0.0;
    animate opacity { duration: 180ms; easing: ease-out; }
    init => { root.ready = true; }

    Rectangle {
        height: 70px;
        y: 0px;
        background: @linear-gradient(180deg, Theme.accent-dim 0%, transparent 100%);
    }

    VerticalBox {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 10px;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 800;
            horizontal-alignment: left;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 11px;
            horizontal-alignment: left;
        }
        Rectangle { height: 1px; background: Theme.line; }

        @children
    }

    if root.closable : Rectangle {
        x: parent.width - 40px;
        y: 12px;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: close-ta.has-hover ? Theme.danger-hover : Theme.field;
        border-width: 1px;
        border-color: close-ta.has-hover ? Theme.danger-border-hover : Theme.field-border;
        animate background { duration: 120ms; }

        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 0 0 L 10 10 M 10 0 L 0 10";
            stroke: close-ta.has-hover ? Theme.danger-text : Theme.text-soft;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            animate stroke { duration: 120ms; }
        }

        close-ta := TouchArea {
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Cerrar";
            clicked => { root.close(); }
        }
    }
}

// ─── Bandeja del sistema (nativa de Slint) ─────────────────────────────────

export component TrayIcon inherits SystemTrayIcon {
    in property <string> tray-tooltip: "MoonWolf Agent";
    callback open-window();
    callback quit-app();

    icon: @image-url("../../assets/icon.ico");
    tooltip: root.tray-tooltip;

    Menu {
        MenuItem {
            title: "Abrir MoonWolf Agent";
            activated => { root.open-window(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Salir";
            activated => { root.quit-app(); }
        }
    }
}

// ─── Ventana principal ──────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "MoonWolf Agent";
    min-width: 320px;
    preferred-width: 360px;
    max-width: 400px;
    background: Theme.bg;
    icon: @image-url("../../assets/icon.ico");

    callback open-panel();
    callback open-config();
    callback open-server();
    callback change-server(string);
    callback copy-pairing();
    callback clear-logs();
    callback save-logs();
    callback check-update();
    callback apply-update();
    callback restart-agent();
    callback hide-tray();
    callback quit-agent();
    callback log-filter-changed(int);

    in-out property <string> status-title: "Conectando...";
    in-out property <string> status-description: "Conectando con MoonWolf Cloud";
    in-out property <string> pairing-code: "—";
    in-out property <string> server-dir: "—";
    in-out property <string> version: "—";
    in-out property <string> local-status: "Servidor local";
    in-out property <string> update-text: "";
    in-out property <string> logs-text: "";
    in-out property <bool> cloud-connected: false;
    in-out property <bool> local-ready: false;
    in-out property <bool> update-visible: false;
    in-out property <bool> update-installable: false;
    in-out property <bool> update-failed: false;
    in-out property <bool> restart-visible: false;
    in-out property <bool> logs-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> serverdir-visible: false;
    in-out property <string> serverdir-input: "";
    in-out property <string> copy-label: "Copiar";
    in-out property <int> log-filter: 0;

    Rectangle {
        height: 100%;
        background: @linear-gradient(170deg, Theme.header-grad-1 0%, Theme.bg 45%, Theme.header-grad-2 100%);

        Rectangle {
            x: (parent.width - 380px) / 2;
            y: -150px;
            width: 380px;
            height: 300px;
            background: @radial-gradient(circle, Theme.ring-glow 0%, transparent 70%);
        }

        VerticalBox {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 10px;
            alignment: start;

            // ── Cabecera ──
            HorizontalBox {
                height: 48px;
                spacing: 12px;
                alignment: center;

                // Logo
                Image {
                    source: @image-url("../../assets/icon.ico");
                    width: 42px;
                    height: 42px;
                    image-fit: contain;
                }

                VerticalBox {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "MoonWolf";
                        color: Theme.pure-white;
                        font-size: 19px;
                        font-weight: 800;
                    }
                    Text {
                        text: "AGENT";
                        color: Theme.accent;
                        font-size: 8px;
                        font-weight: 800;
                        letter-spacing: 3.5px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // ── Estado ──
            Rectangle {
                height: 58px;
                border-radius: 13px;
                background: root.cloud-connected
                    ? @linear-gradient(90deg, Theme.ok-bg-start 0%, Theme.card 75%)
                    : @linear-gradient(90deg, Theme.warn-bg-start 0%, Theme.card 75%);
                border-width: 1px;
                border-color: root.cloud-connected ? Theme.ok-border : Theme.warn-border;
                drop-shadow-blur: 14px;
                drop-shadow-color: root.cloud-connected ? Theme.ok-glow : Theme.warn-glow;
                clip: true;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;

                    StatusDot { ok: root.cloud-connected; }
                    VerticalBox {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.cloud-connected ? "Conectado" : root.status-title;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: root.cloud-connected ? "Conexión activa con MoonWolf Cloud" : root.status-description;
                            color: root.cloud-connected ? Theme.ok-text : Theme.warn-text;
                            font-size: 10px;
                            overflow: elide;
                            horizontal-alignment: left;
                        }
                    }
                }
            }

            Text {
                text: "INFORMACIÓN DEL AGENT";
                color: Theme.muted-dim;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.8px;
                horizontal-alignment: left;
            }

            // ── Tarjeta de información ──
            Rectangle {
                border-radius: 14px;
                background: @linear-gradient(180deg, Theme.panel-grad-top 0%, Theme.modal-bg 100%);
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.shadow-soft;
                clip: true;

                // Línea de acento superior
                Rectangle {
                    y: 0px;
                    height: 2px;
                    background: @linear-gradient(90deg, transparent 0%, Theme.accent 50%, transparent 100%);
                    opacity: 0.55;
                }

                VerticalBox {
                    padding: 2px;
                    spacing: 0px;
                    alignment: start;
                    FieldRow {
                        caption: "CÓDIGO DE EMPAREJAMIENTO";
                        value: root.pairing-code;
                        code: true;
                        action-label: root.copy-label;
                        action-clicked => { root.copy-pairing(); }
                    }
                    Divider { }
                    FieldRow {
                        caption: "CARPETA DEL SERVIDOR";
                        value: root.server-dir;
                        action-label: "Cambiar";
                        action-clicked => {
                            root.settings-visible = false;
                            root.logs-visible = false;
                            root.serverdir-visible = !root.serverdir-visible;
                        }
                    }
                    Divider { }
                    Rectangle {
                        height: 54px;
                        background: transparent;
                        clip: true;
                        HorizontalBox {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: center;
                            VerticalBox {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: "VERSIÓN";
                                    color: Theme.muted-dim;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 1.4px;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: "v" + root.version;
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: left;
                                }
                            }
                            Rectangle { width: 1px; height: 28px; background: Theme.line; }
                            VerticalBox {
                                width: 12px;
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.local-ready ? Theme.green : Theme.amber;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: (root.local-ready ? Theme.green : Theme.amber).with-alpha(0.7);
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: root.local-status;
                                    color: Theme.muted-dim;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 1.2px;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: root.local-ready ? "En funcionamiento" : "Iniciando...";
                                    color: root.local-ready ? Theme.ok-soft : Theme.warn-soft;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
            }

            // ── Acciones ──
            ActionButton {
                height: 44px;
                label: "Abrir MoonWolf Panel  →";
                label-font-size: 13px;
                primary: true;
                clicked => { root.open-panel(); }
            }

            HorizontalBox {
                height: 40px;
                spacing: 8px;
                padding: 0px;
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Configuración";
                    clicked => {
                        root.logs-visible = false;
                        root.serverdir-visible = false;
                        root.settings-visible = !root.settings-visible;
                    }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Logs";
                    clicked => {
                        root.settings-visible = false;
                        root.serverdir-visible = false;
                        root.logs-visible = !root.logs-visible;
                    }
                }
            }

            if root.update-visible : Rectangle {
                height: 56px;
                border-radius: 14px;
                background: @linear-gradient(90deg, Theme.info-bg-start 0%, Theme.modal-bg 100%);
                border-width: 1px;
                border-color: Theme.info-border;
                HorizontalBox {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: root.update-text;
                        color: Theme.info-text;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    if root.update-installable : ActionButton {
                        width: 80px;
                        height: 34px;
                        label: "Instalar";
                        primary: true;
                        clicked => { root.apply-update(); }
                    }
                    if root.update-failed : ActionButton {
                        width: 80px;
                        height: 34px;
                        label: "Reintentar";
                        clicked => { root.check-update(); }
                    }
                    if !root.update-installable && !root.update-failed : Text {
                        text: "Descargando";
                        color: Theme.accent-soft;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            if root.restart-visible : Rectangle {
                height: 52px;
                border-radius: 14px;
                background: @linear-gradient(90deg, Theme.warn-banner-start 0%, Theme.warn-banner-end 100%);
                border-width: 1px;
                border-color: Theme.warn-banner-border;
                HorizontalBox {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: "Hay un reinicio pendiente";
                        color: Theme.warn-banner-text;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    ActionButton {
                        width: 96px;
                        height: 34px;
                        label: "Reiniciar";
                        clicked => { root.restart-agent(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            Text {
                text: "MOONWOLF · 2026";
                color: Theme.muted-dim;
                font-size: 8px;
                font-weight: 700;
                letter-spacing: 2px;
                horizontal-alignment: center;
            }
        }

        // ── Fondo oscuro de los modales ──
        if root.settings-visible || root.logs-visible || root.serverdir-visible : Rectangle {
            height: 100%;
            background: Theme.overlay-scrim;
            TouchArea {
                clicked => {
                    root.settings-visible = false;
                    root.logs-visible = false;
                    root.serverdir-visible = false;
                }
            }
        }

        // ── Configuración ──
        if root.settings-visible : Modal {
            x: 14px;
            y: (root.height - self.height) / 2;
            width: root.width - 28px;
            height: root.update-visible ? 336px : 262px;
            title: "Configuración";
            subtitle: "Gestiona las opciones de MoonWolf Agent.";
            close => { root.settings-visible = false; }

            ActionButton {
                label: "Abrir carpeta de configuración";
                clicked => { root.open-config(); }
            }
            ActionButton {
                label: "Buscar actualizaciones";
                clicked => { root.check-update(); }
            }
            if root.update-visible : Rectangle {
                height: 56px;
                border-radius: 12px;
                background: @linear-gradient(90deg, Theme.info-bg-start 0%, Theme.modal-bg 100%);
                border-width: 1px;
                border-color: Theme.info-border;
                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: root.update-text;
                        color: Theme.info-text;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    if root.update-installable : ActionButton {
                        width: 76px;
                        height: 32px;
                        label: "Instalar";
                        primary: true;
                        clicked => { root.apply-update(); }
                    }
                    if root.update-failed : ActionButton {
                        width: 76px;
                        height: 32px;
                        label: "Reintentar";
                        clicked => { root.check-update(); }
                    }
                    if !root.update-installable && !root.update-failed : Text {
                        text: "Descargando";
                        color: Theme.accent-soft;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            ActionButton {
                label: "Ocultar en segundo plano";
                clicked => { root.hide-tray(); }
            }
        }

        // ── Registros ──
        if root.logs-visible : Modal {
            x: 14px;
            y: (root.height - self.height) / 2;
            width: root.width - 28px;
            height: 392px;
            title: "Registros del Agent";
            close => { root.logs-visible = false; }

            HorizontalBox {
                spacing: 6px;
                padding: 0px;
                height: 26px;
                LogChip {
                    label: "Todos";
                    active: root.log-filter == 0;
                    clicked => { root.log-filter = 0; root.log-filter-changed(0); }
                }
                LogChip {
                    label: "Info";
                    tone: Theme.accent;
                    active: root.log-filter == 1;
                    clicked => { root.log-filter = 1; root.log-filter-changed(1); }
                }
                LogChip {
                    label: "Aviso";
                    tone: Theme.amber;
                    active: root.log-filter == 2;
                    clicked => { root.log-filter = 2; root.log-filter-changed(2); }
                }
                LogChip {
                    label: "Error";
                    tone: Theme.danger;
                    active: root.log-filter == 3;
                    clicked => { root.log-filter = 3; root.log-filter-changed(3); }
                }
            }
            HorizontalBox {
                spacing: 10px;
                padding: 0px;
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Limpiar";
                    clicked => { root.clear-logs(); }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    label: "Guardar archivo";
                    clicked => { root.save-logs(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 180px;
                border-radius: 12px;
                background: Theme.code-bg;
                border-width: 1px;
                border-color: Theme.line;
                clip: true;

                ScrollView {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    viewport-width: self.visible-width;
                    // viewport-height grows with content

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        text: root.logs-text == "" ? "No hay registros para este filtro.\nLos eventos del Agent aparecerán aquí." : root.logs-text;
                        color: root.logs-text == "" ? Theme.log-empty : Theme.log-text;
                        font-family: "Consolas";
                        font-size: 10px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                    }
                }
            }
        }

        // ── Carpeta del servidor ──
        if root.serverdir-visible : Modal {
            x: 14px;
            y: (root.height - self.height) / 2;
            width: root.width - 28px;
            height: 270px;
            title: "Carpeta del servidor";
            subtitle: "Indica la ruta de la carpeta local del servidor.";
            close => { root.serverdir-visible = false; }

            LineEdit {
                text <=> root.serverdir-input;
                placeholder-text: "Ruta completa de la carpeta...";
                height: 40px;
                horizontal-stretch: 1;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalBox {
                spacing: 10px;
                height: 40px;
                padding: 0px;
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "Cancelar";
                    clicked => { root.serverdir-visible = false; }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    height: 40px;
                    label: "Guardar";
                    primary: true;
                    clicked => {
                        root.change-server(root.serverdir-input);
                        root.serverdir-visible = false;
                    }
                }
            }
        }
    }
}
