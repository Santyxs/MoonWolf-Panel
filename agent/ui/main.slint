import { Button, LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "MoonWolf Agent";
    min-width: 420px;
    preferred-width: 440px;
    min-height: 620px;
    preferred-height: 700px;
    background: #0b1017;

    callback open-panel();
    callback open-config();
    callback open-server();
    callback change-server(string);
    callback copy-pairing();
    callback clear-logs();
    callback save-logs();
    callback check-update();
    callback apply-update();
    callback restart-agent();
    callback hide-tray();
    callback quit-agent();

    in-out property <string> status-title: "Conectando...";
    in-out property <string> status-description: "Conectando con MoonWolf Cloud";
    in-out property <string> pairing-code: "—";
    in-out property <string> server-dir: "—";
    in-out property <string> version: "—";
    in-out property <string> local-status: "Servidor local";
    in-out property <string> agent-id: "—";
    in-out property <string> config-dir: "—";
    in-out property <string> update-text: "";
    in-out property <string> logs-text: "";
    in-out property <bool> cloud-connected: false;
    in-out property <bool> local-ready: false;
    in-out property <bool> update-visible: false;
    in-out property <bool> restart-visible: false;
    in-out property <bool> logs-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> serverdir-visible: false;
    in-out property <string> serverdir-input: "";

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0b1017;
    }

    VerticalBox {
        padding: 18px;
        spacing: 12px;

        // Header
        HorizontalBox {
            alignment: center;
            spacing: 14px;

            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                background: #111d2d;
                border-width: 1px;
                border-color: #214765;

                Rectangle {
                    x: 2px; y: 2px;
                    width: 48px; height: 48px;
                    border-radius: 14px;
                    background: #09141c;
                }

                Rectangle {
                    x: 10px; y: 10px;
                    width: 28px; height: 28px;
                    border-radius: 14px;
                    background: #3ad0ff;
                }

                Rectangle {
                    x: 18px; y: 8px;
                    width: 24px; height: 24px;
                    border-radius: 12px;
                    background: #09141c;
                }

                Rectangle {
                    x: 15px; y: 14px;
                    width: 5px; height: 5px;
                    border-radius: 3px;
                    background: #dff9ff;
                }
            }

            VerticalBox {
                spacing: 2px;
                alignment: center;

                Text {
                    text: "MoonWolf";
                    color: #eef7ff;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "AGENT";
                    color: #5bbbe8;
                    font-size: 11px;
                    letter-spacing: 3px;
                    font-weight: 700;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                border-radius: 10px;
                background: #101d2d;
                border-width: 1px;
                border-color: #214765;

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;

                    Text {
                        text: "v" + root.version;
                        color: #8aa7bb;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }
            }
        }

        // Cloud state
        Rectangle {
            height: 78px;
            border-radius: 14px;
            background: #101a26;
            border-width: 1px;
            border-color: root.cloud-connected ? #1d7d67 : #2d425b;

            HorizontalBox {
                padding: 14px;
                spacing: 12px;
                alignment: center;

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.cloud-connected ? #38d7a8 : #f6c76b;
                }

                VerticalBox {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: root.status-title;
                        color: #f3f8ff;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.status-description;
                        color: #8ea7ba;
                        font-size: 11px;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Main block
        Rectangle {
            border-radius: 14px;
            background: #101a26;
            border-width: 1px;
            border-color: #21374a;

            VerticalBox {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "EMPAREJAMIENTO";
                    color: #6a8299;
                    font-size: 10px;
                    letter-spacing: 1.2px;
                    font-weight: 700;
                }

                HorizontalBox {
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: root.pairing-code;
                        color: #69d5ff;
                        font-size: 22px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Copiar";
                        primary: true;
                        clicked => { root.copy-pairing(); }
                    }
                }

                Rectangle { height: 1px; background: #1d2d3d; }

                Text {
                    text: "CARPETA DEL SERVIDOR";
                    color: #6a8299;
                    font-size: 10px;
                    letter-spacing: 1.2px;
                    font-weight: 700;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: root.server-dir;
                        color: #d9e9f7;
                        font-size: 12px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "Abrir";
                        clicked => { root.open-server(); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "SERVIDOR LOCAL";
                        color: #6b8299;
                        font-size: 10px;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        border-radius: 8px;
                        background: root.local-ready ? #0d2b29 : #2d2b18;
                        border-width: 1px;
                        border-color: root.local-ready ? #1d7d67 : #705a22;

                        HorizontalBox {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            Text {
                                text: root.local-ready ? "● Listo" : "● Iniciando";
                                color: root.local-ready ? #56e1b5 : #f6c76b;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        if root.update-visible : Rectangle {
            border-radius: 14px;
            background: #152235;
            border-width: 1px;
            border-color: #2b5a7e;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: root.update-text;
                    color: #dfeefc;
                    font-size: 12px;
                }

                Button {
                    text: "Instalar actualización";
                    primary: true;
                    clicked => { root.apply-update(); }
                }
            }
        }

        if root.restart-visible : Rectangle {
            border-radius: 14px;
            background: #2a2219;
            border-width: 1px;
            border-color: #6a4d1a;

            HorizontalBox {
                padding: 12px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "Reinicio pendiente";
                    color: #f4d79b;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "Reiniciar";
                    clicked => { root.restart-agent(); }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;

            Button {
                text: "Abrir Panel";
                primary: true;
                horizontal-stretch: 1;
                clicked => { root.open-panel(); }
            }

            Button {
                text: root.settings-visible ? "● Config" : "Configuración";
                horizontal-stretch: 1;
                clicked => {
                    root.logs-visible = false;
                    root.serverdir-visible = false;
                    root.settings-visible = !root.settings-visible;
                }
            }

            Button {
                text: root.logs-visible ? "● Logs" : "Logs";
                horizontal-stretch: 1;
                clicked => {
                    root.settings-visible = false;
                    root.serverdir-visible = false;
                    root.logs-visible = !root.logs-visible;
                }
            }
        }

        if root.settings-visible : Rectangle {
            border-radius: 14px;
            background: #101a26;
            border-width: 1px;
            border-color: #254968;
            min-height: 170px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "CONFIGURACIÓN";
                    color: #68d4ff;
                    font-size: 11px;
                    letter-spacing: 1.5px;
                    font-weight: 800;
                }

                Rectangle {
                    border-radius: 12px;
                    background: #0b1117;
                    border-width: 1px;
                    border-color: #1d2d3d;

                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;

                        Text {
                            text: "Carpeta de config";
                            color: #6c8297;
                            font-size: 10px;
                        }

                        Text {
                            text: root.config-dir;
                            color: #d4e3f5;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    border-radius: 12px;
                    background: #0b1117;
                    border-width: 1px;
                    border-color: #1d2d3d;

                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;

                        Text {
                            text: "Agent ID";
                            color: #6c8297;
                            font-size: 10px;
                        }

                        Text {
                            text: root.agent-id;
                            color: #d4e3f5;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                HorizontalBox {
                    spacing: 8px;

                    Button {
                        text: "Abrir carpeta";
                        horizontal-stretch: 1;
                        clicked => { root.open-config(); }
                    }

                    Button {
                        text: "Cambiar servidor";
                        horizontal-stretch: 1;
                        clicked => { root.serverdir-visible = !root.serverdir-visible; }
                    }
                }

                HorizontalBox {
                    spacing: 8px;

                    Button {
                        text: "Buscar update";
                        horizontal-stretch: 1;
                        clicked => { root.check-update(); }
                    }

                    Button {
                        text: "Minimizar a bandeja";
                        horizontal-stretch: 1;
                        clicked => { root.hide-tray(); }
                    }
                }
            }
        }

        if root.serverdir-visible : Rectangle {
            border-radius: 14px;
            background: #101a26;
            border-width: 1px;
            border-color: #2a4c66;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "Nueva carpeta del servidor";
                    color: #edf6ff;
                    font-size: 13px;
                    font-weight: 700;
                }

                LineEdit {
                    text <=> root.serverdir-input;
                    placeholder-text: "Ruta completa de la carpeta...";
                }

                HorizontalBox {
                    spacing: 8px;

                    Button {
                        text: "Cancelar";
                        horizontal-stretch: 1;
                        clicked => { root.serverdir-visible = false; }
                    }

                    Button {
                        text: "Guardar";
                        primary: true;
                        horizontal-stretch: 1;
                        clicked => {
                            root.change-server(root.serverdir-input);
                            root.serverdir-visible = false;
                        }
                    }
                }
            }
        }

        if root.logs-visible : Rectangle {
            border-radius: 14px;
            background: #0b1219;
            border-width: 1px;
            border-color: #224d67;
            vertical-stretch: 1;
            min-height: 220px;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "REGISTRO";
                        color: #68d4ff;
                        font-size: 11px;
                        letter-spacing: 1.5px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Limpiar";
                        clicked => { root.clear-logs(); }
                    }

                    Button {
                        text: "Guardar";
                        clicked => { root.save-logs(); }
                    }
                }

                Rectangle {
                    border-radius: 12px;
                    background: #060b10;
                    border-width: 1px;
                    border-color: #1c2f40;
                    vertical-stretch: 1;
                    min-height: 160px;

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalBox {
                            padding: 10px;

                            Text {
                                text: root.logs-text == "" ? "Sin registros todavía.\nLos eventos del agent aparecerán aquí." : root.logs-text;
                                color: root.logs-text == "" ? #53687a : #c0d7ea;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if !root.logs-visible : Rectangle {
            vertical-stretch: 1;
            min-height: 8px;
        }

        Text {
            text: "MoonWolf Agent · Windows";
            color: #3f526d;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}
