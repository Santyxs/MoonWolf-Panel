import { LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    height: 40px;
    border-radius: 10px;
    background: root.primary ? #7563e8 : #20243a;
    border-width: 1px;
    border-color: root.primary ? #9588ff : #363b58;

    Text {
        text: root.label;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component FieldRow inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <string> action-label;
    callback action-clicked();

    height: 64px;
    background: #14172a;

    HorizontalBox {
        padding-left: 15px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        VerticalBox {
            spacing: 5px;
            horizontal-stretch: 1;
            Text {
                text: root.caption;
                color: #858ba7;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.1px;
            }
            Text {
                text: root.value;
                color: #f2f1fb;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
        }
        if root.action-label != "" : ActionButton {
            width: 76px;
            height: 32px;
            label: root.action-label;
            clicked => { root.action-clicked(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "MoonWolf Agent";
    min-width: 410px;
    preferred-width: 480px;
    max-width: 540px;
    min-height: 620px;
    preferred-height: 700px;
    max-height: 800px;
    background: #0b0d18;

    callback open-panel();
    callback open-config();
    callback open-server();
    callback change-server(string);
    callback copy-pairing();
    callback clear-logs();
    callback save-logs();
    callback check-update();
    callback apply-update();
    callback restart-agent();
    callback hide-tray();
    callback quit-agent();

    in-out property <string> status-title: "Conectando...";
    in-out property <string> status-description: "Conectando con MoonWolf Cloud";
    in-out property <string> pairing-code: "—";
    in-out property <string> server-dir: "—";
    in-out property <string> version: "—";
    in-out property <string> local-status: "Servidor local";
    in-out property <string> agent-id: "—";
    in-out property <string> config-dir: "—";
    in-out property <string> update-text: "";
    in-out property <string> logs-text: "";
    in-out property <bool> cloud-connected: false;
    in-out property <bool> local-ready: false;
    in-out property <bool> update-visible: false;
    in-out property <bool> restart-visible: false;
    in-out property <bool> logs-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> serverdir-visible: false;
    in-out property <string> serverdir-input: "";

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0b0d18;

        VerticalBox {
            padding-left: 30px;
            padding-right: 30px;
            padding-top: 22px;
            padding-bottom: 14px;
            spacing: 13px;

            HorizontalBox {
                height: 76px;
                spacing: 15px;
                alignment: center;

                Rectangle {
                    width: 60px;
                    height: 60px;
                    border-radius: 17px;
                    background: #6d5be5;
                    border-width: 1px;
                    border-color: #9587ff;

                    Rectangle {
                        x: 15px; y: 15px;
                        width: 32px; height: 32px;
                        border-radius: 16px;
                        background: #ffffff;
                    }
                    Rectangle {
                        x: 26px; y: 9px;
                        width: 32px; height: 32px;
                        border-radius: 16px;
                        background: #6d5be5;
                    }
                    Rectangle {
                        x: 13px; y: 12px;
                        width: 5px; height: 5px;
                        border-radius: 3px;
                        background: #dcd6ff;
                    }
                }

                VerticalBox {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "MoonWolf";
                        color: #fbfaff;
                        font-size: 25px;
                        font-weight: 800;
                    }
                    Text {
                        text: "AGENT  /  WINDOWS";
                        color: #9691b9;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 2px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "v" + root.version;
                    color: #777b99;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 82px;
                border-radius: 16px;
                background: #15182b;
                border-width: 1px;
                border-color: #2b3050;

                HorizontalBox {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 13px;
                    alignment: center;

                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: root.cloud-connected ? #53e6b5 : #f0bd65;
                    }
                    VerticalBox {
                        spacing: 5px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.cloud-connected ? "Conectado" : root.status-title;
                            color: #fbfaff;
                            font-size: 16px;
                            font-weight: 800;
                        }
                        Text {
                            text: root.cloud-connected ? "Conexión activa con MoonWolf Cloud" : root.status-description;
                            color: #a4a7c0;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        width: 66px;
                        height: 25px;
                        border-radius: 8px;
                        background: root.cloud-connected ? #173d38 : #40351f;
                        Text {
                            text: root.cloud-connected ? "ONLINE" : "WAITING";
                            color: root.cloud-connected ? #69e8c0 : #f1ca7c;
                            font-size: 8px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "INFORMACIÓN DEL AGENT";
                color: #858ba7;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.5px;
            }

            Rectangle {
                border-radius: 15px;
                background: #14172a;
                border-width: 1px;
                border-color: #292e4a;

                VerticalBox {
                    padding: 5px;
                    spacing: 0px;
                    FieldRow {
                        caption: "CÓDIGO DE EMPAREJAMIENTO";
                        value: root.pairing-code;
                        action-label: "Copiar";
                        action-clicked => { root.copy-pairing(); }
                    }
                    Rectangle { height: 1px; background: #292e46; }
                    FieldRow {
                        caption: "CARPETA DEL SERVIDOR";
                        value: root.server-dir;
                        action-label: "Cambiar";
                        action-clicked => {
                            root.settings-visible = false;
                            root.logs-visible = false;
                            root.serverdir-visible = !root.serverdir-visible;
                        }
                    }
                    Rectangle { height: 1px; background: #292e46; }
                    Rectangle {
                        height: 64px;
                        background: #14172a;
                        HorizontalBox {
                            padding-left: 15px;
                            padding-right: 15px;
                            spacing: 8px;
                            alignment: center;
                            VerticalBox {
                                spacing: 5px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "VERSIÓN INSTALADA";
                                    color: #858ba7;
                                    font-size: 9px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                }
                                Text {
                                    text: "v" + root.version;
                                    color: #f2f1fb;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                            Rectangle { width: 1px; height: 32px; background: #303550; }
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 5px;
                                background: root.local-ready ? #53e6b5 : #f0bd65;
                            }
                            VerticalBox {
                                spacing: 3px;
                                Text { text: "SERVIDOR LOCAL"; color: #a4a7c0; font-size: 9px; }
                                Text {
                                    text: root.local-ready ? "En funcionamiento" : "Iniciando...";
                                    color: root.local-ready ? #69e8c0 : #f1ca7c;
                                    font-size: 10px;
                                    font-weight: 700;
                                }
                            }
                        }
                    }
                }
            }

            ActionButton {
                height: 48px;
                label: "Abrir MoonWolf Panel  →";
                primary: true;
                clicked => { root.open-panel(); }
            }

            HorizontalBox {
                height: 42px;
                spacing: 10px;
                ActionButton {
                    horizontal-stretch: 1;
                    label: "⚙   Configuración";
                    clicked => {
                        root.logs-visible = false;
                        root.serverdir-visible = false;
                        root.settings-visible = !root.settings-visible;
                    }
                }
                ActionButton {
                    horizontal-stretch: 1;
                    label: "▤   Ver registros";
                    clicked => {
                        root.settings-visible = false;
                        root.serverdir-visible = false;
                        root.logs-visible = !root.logs-visible;
                    }
                }
            }

            if root.update-visible : Rectangle {
                height: 54px;
                border-radius: 12px;
                background: #242044;
                border-width: 1px;
                border-color: #554b91;
                HorizontalBox {
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: root.update-text;
                        color: #e8e4ff;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        width: 76px;
                        label: "Instalar";
                        primary: true;
                        clicked => { root.apply-update(); }
                    }
                }
            }

            if root.restart-visible : Rectangle {
                height: 50px;
                border-radius: 12px;
                background: #332b27;
                border-width: 1px;
                border-color: #74532b;
                HorizontalBox {
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: "Hay un reinicio pendiente";
                        color: #f4d79b;
                        font-size: 10px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        width: 90px;
                        label: "Reiniciar";
                        clicked => { root.restart-agent(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
            Text {
                text: "MOONWOLF AGENT   •   WINDOWS";
                color: #555a77;
                font-size: 8px;
                font-weight: 700;
                letter-spacing: 1.3px;
                horizontal-alignment: center;
            }
        }

        if root.settings-visible : Rectangle {
            x: 24px;
            y: (root.height - 250px) / 2;
            width: root.width - 48px;
            height: 250px;
            border-radius: 16px;
            background: #191c32;
            border-width: 1px;
            border-color: #6256b4;
            drop-shadow-blur: 24px;
            drop-shadow-color: #05050ddd;

            VerticalBox {
                padding: 17px;
                spacing: 12px;
                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Configuración";
                        color: #faf8ff;
                        font-size: 17px;
                        font-weight: 800;
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        width: 34px;
                        label: "×";
                        clicked => { root.settings-visible = false; }
                    }
                }
                Text { text: "Gestiona las opciones de MoonWolf Agent."; color: #a4a7c0; font-size: 10px; }
                Rectangle { height: 1px; background: #343957; }
                ActionButton {
                    height: 38px;
                    label: "Abrir carpeta de configuración";
                    clicked => { root.open-config(); }
                }
                ActionButton {
                    height: 38px;
                    label: "Buscar actualizaciones";
                    clicked => { root.check-update(); }
                }
                HorizontalBox {
                    spacing: 8px;
                    ActionButton {
                        horizontal-stretch: 1;
                        label: "Cambiar servidor";
                        clicked => { root.serverdir-visible = true; }
                    }
                    ActionButton {
                        horizontal-stretch: 1;
                        label: "Minimizar";
                        clicked => { root.hide-tray(); }
                    }
                }
            }
        }

        if root.logs-visible : Rectangle {
            x: 24px;
            y: (root.height - 390px) / 2;
            width: root.width - 48px;
            height: 390px;
            border-radius: 16px;
            background: #191c32;
            border-width: 1px;
            border-color: #6256b4;
            drop-shadow-blur: 24px;
            drop-shadow-color: #05050ddd;

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Registros del Agent";
                        color: #faf8ff;
                        font-size: 16px;
                        font-weight: 800;
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        width: 34px;
                        label: "×";
                        clicked => { root.logs-visible = false; }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    ActionButton {
                        horizontal-stretch: 1;
                        label: "Limpiar";
                        clicked => { root.clear-logs(); }
                    }
                    ActionButton {
                        horizontal-stretch: 1;
                        label: "Guardar archivo";
                        clicked => { root.save-logs(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: #0d1020;
                    border-width: 1px;
                    border-color: #303550;
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalBox {
                            padding: 10px;
                            Text {
                                text: root.logs-text == "" ? "Todavía no hay registros.\nLos eventos del Agent aparecerán aquí." : root.logs-text;
                                color: root.logs-text == "" ? #777c98 : #d2d5e8;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if root.serverdir-visible : Rectangle {
            x: (root.width - 390px) / 2;
            y: (root.height - 230px) / 2;
            width: 390px;
            height: 230px;
            border-radius: 16px;
            background: #191c32;
            border-width: 1px;
            border-color: #6256b4;
            drop-shadow-blur: 24px;
            drop-shadow-color: #05050ddd;

            VerticalBox {
                padding: 17px;
                spacing: 12px;
                Text { text: "Carpeta del servidor"; color: #faf8ff; font-size: 17px; font-weight: 800; }
                Text { text: "Indica la ruta de la carpeta local."; color: #a4a7c0; font-size: 10px; }
                LineEdit {
                    text <=> root.serverdir-input;
                    placeholder-text: "Ruta completa de la carpeta...";
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    spacing: 8px;
                    ActionButton {
                        horizontal-stretch: 1;
                        label: "Cancelar";
                        clicked => { root.serverdir-visible = false; }
                    }
                    ActionButton {
                        horizontal-stretch: 1;
                        label: "Guardar";
                        primary: true;
                        clicked => {
                            root.change-server(root.serverdir-input);
                            root.serverdir-visible = false;
                        }
                    }
                }
            }
        }
    }
}
